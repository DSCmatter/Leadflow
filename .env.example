# Backend (FastAPI) - copy values into your shell or a local .env file.
DATABASE_PATH=./data/leadflow.db
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Autter Runtime
# Server ingest key (autter_rt_...). Create it in the Autter dashboard:
# Settings -> Access Tokens -> Runtime ingest keys. Keep the real value in a
# gitignored .env / your shell or secret manager; never commit it.
AUTTER_RUNTIME_KEY=

# Backend telemetry (used only when OTEL_EXPORTER_OTLP_ENDPOINT is set).
# In docker compose these are filled in from AUTTER_RUNTIME_KEY above.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.autter.dev
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ${AUTTER_RUNTIME_KEY}
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=leadflow-api
OTEL_RESOURCE_ATTRIBUTES=service.version=${GIT_SHA},deployment.environment=development
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.01
